# Copy to .env for running on a computer. On Vercel, set these in
# Project → Settings → Environment Variables instead.

# The database. On Vercel the Neon integration fills these in for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movienight"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/movienight"

# The passcode you both type once on each phone.
APP_PASSCODE="change-me"
# Any long random text. Signs the sign-in cookie and the calendar link.
SESSION_SECRET="replace-with-a-long-random-string"

# TMDB "API Read Access Token" (the long one), from themoviedb.org → Settings → API.
TMDB_TOKEN=""
# OMDb key (free, omdbapi.com). Adds IMDb, Rotten Tomatoes and Metacritic scores.
OMDB_KEY=""

# Optional: Claude writes "why you'd both like it". Leave empty to switch off.
ANTHROPIC_API_KEY=""
# Optional overrides.
# ANTHROPIC_MODEL="claude-haiku-5-5"
# CLAUDE_MONTHLY_CAP_USD="3"
